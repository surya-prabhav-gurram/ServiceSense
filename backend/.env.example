# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PostgreSQL (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/servicesense

# Server
PORT=3001
NODE_ENV=development

# HITL confidence threshold (0.0 - 1.0)
HITL_THRESHOLD=0.70

# Salesforce (for webhook verification)
SF_CLIENT_SECRET=your_sf_connected_app_secret
